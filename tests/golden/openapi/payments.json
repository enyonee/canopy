            "body": {
              "type": "object",
              "properties": {
                "amount": {
                  "type": "integer",
                  "minimum": 1
                },
                "currency": {
                  "type": "string",
                  "pattern": "^[a-z]{3}$"
                },
                "metadata[order]": {
                  "type": "string"
                },
                "capture": {
                  "type": "boolean",
                  "default": true
                },
                "kind": {
                  "enum": [
                    "card"
                  ]
                }
              },
              "required": [
                "amount",
                "currency"
              ],
              "additionalProperties": true
            }
          },
          "required": [
            "body"
          ]
        },
        "request": {
          "method": "POST",
          "url": "{base}/v1/charges",
          "headers": {
            "accept": "application/json",
            "authorization": "Basic {secret.basic}"
          },
          "body": {
            "$": "input.body"
          },
          "encoding": "form"
        },
        "output": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "status": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ]
        }
      },
      "refund": {
        "idempotent": true,
        "input": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "idempotency_key": {
              "type": "string"
            },
            "amount": {
              "type": "integer"
            }
          },
          "required": [
            "id"
          ]
        },
        "request": {
          "method": "POST",
          "url": "{base}/v1/charges/{input.id}/refunds",
          "headers": {
            "accept": "application/json",
            "idempotency_key": {
              "$": "input.idempotency_key"
            },
            "authorization": "Basic {secret.basic}"
          },
          "body": {
            "amount": {
              "$": "input.amount"
            }
          },
          "encoding": "form"
        },
        "output": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            }
          }
        }
      },
      "getCharge": {
        "idempotent": true,
        "input": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ]
        },
        "request": {
          "method": "GET",
          "url": "{base}/v1/charges/{input.id}"
        }
      }
    }
  },
  "unsupported": [
