    },
    {
      "path": "#/paths/~1v1~1charges/post/requestBody/content",
      "message": "multipart/form-data not mapped: the body is sent as application/x-www-form-urlencoded"
    },
    {
      "path": "#/paths/~1v1~1charges/post/requestBody/content/application~1x-www-form-urlencoded/schema/properties/capture/type",
