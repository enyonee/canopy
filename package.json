{
  "name": "canopy",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "coverage": "node tests/coverage.mjs",
    "types": "tsc -p .",
    "verify": "node verify/run.mjs",
    "bench": "node --no-warnings --expose-gc bench/run.mjs",
    "gate": "npm run test && npm run test:async && npm run coverage && npm run types",
    "test:async": "node --no-warnings --import ./tests/asyncstore.mjs --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "puppeteer-core": "25.18.1",
    "typescript": "^5.9.3"
  },
  "description": "A lightweight app runtime: one JSON document in, a working app out.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enyonee/canopy.git"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "lightweight",
    "low-code",
    "app-generator",
    "json",
    "sqlite",
    "llm",
    "declarative"
  ],
  "dependencies": {
    "@adyen/api-library": "32.3.0",
    "@fastify/busboy": "3.2.6",
    "@googleapis/sheets": "18.1.3",
    "@shopify/admin-api-client": "2.0.1",
    "ajv": "8.20.0",
    "csv-stringify": "6.9.0",
    "stripe": "23.2.0"
  }
}
