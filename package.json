{
  "name": "canopy",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "coverage": "node tests/coverage.mjs",
    "mutate": "node tests/mutate.mjs",
    "types": "tsc -p .",
    "verify": "node verify/run.mjs",
    "bench": "node --no-warnings --expose-gc bench/run.mjs",
    "gate": "npm run test && npm run coverage && npm run types && npm run mutate"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3"
  },
  "description": "A lightweight app runtime: one JSON document in, a working app out. Zero runtime dependencies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enyonee/canopy.git"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "lightweight",
    "low-code",
    "app-generator",
    "json",
    "sqlite",
    "llm",
    "declarative"
  ]
}
