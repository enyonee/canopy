{
  "descriptor": 1,
  "name": "stripe",
  "title": "Stripe: PaymentIntents (create, retrieve, confirm), refunds and signed webhooks",
  "version": "2024-06-20",
  "modes": ["sandbox", "live"],
  "base": "https://api.stripe.com",
  "timeoutMs": 10000,
  "idempotency": { "header": "Idempotency-Key" },
  "retry": { "max": 5, "baseMs": 1000, "capMs": 60000 },
  "operations": {
    "createCheckout": {"idempotent":true,"input":{"type":"object","required":["amountMinor","currency","attemptId","productName","successUrl","cancelUrl"],"properties":{"amountMinor":{"type":"integer","minimum":1,"maximum":99999999},"currency":{"type":"string","pattern":"^[a-z]{3}$"},"attemptId":{"type":"string","pattern":"^[A-Za-z0-9_-]{1,100}$"},"productName":{"type":"string","minLength":1},"successUrl":{"type":"string","pattern":"^https://[A-Za-z0-9.-]+(?::[0-9]+)?(?:/[^\\s]*)?$"},"cancelUrl":{"type":"string","pattern":"^https://[A-Za-z0-9.-]+(?::[0-9]+)?(?:/[^\\s]*)?$"}}},"request":{"method":"POST","url":"{base}/v1/checkout/sessions","headers":{"authorization":"Bearer {secret.apiKey}","stripe-version":"2024-06-20"},"encoding":"form","body":{"mode":"payment","success_url":{"$":"input.successUrl"},"cancel_url":{"$":"input.cancelUrl"},"client_reference_id":{"$":"input.attemptId"},"line_items":[{"price_data":{"currency":{"$":"input.currency"},"unit_amount":{"$":"input.amountMinor"},"product_data":{"name":{"$":"input.productName"}}},"quantity":1}]}},"output":{"type":"object","required":["id","url"],"properties":{"id":{"type":"string","pattern":"^cs_[A-Za-z0-9_]+$"},"url":{"type":"string","pattern":"^https://checkout\\.stripe\\.com/"}}},"result":{"id":"$.id","checkoutUrl":"$.url"},"resultOnly":true},
    "getCheckout": {"idempotent":true,"input":{"type":"object","required":["id"],"properties":{"id":{"type":"string","pattern":"^cs_[A-Za-z0-9_]+$"}}},"request":{"method":"GET","url":"{base}/v1/checkout/sessions/{input.id}","headers":{"authorization":"Bearer {secret.apiKey}","stripe-version":"2024-06-20"}},"output":{"type":"object","required":["id","status","client_reference_id","payment_status","amount_total","currency","livemode","payment_intent"],"properties":{"id":{"type":"string","pattern":"^cs_[A-Za-z0-9_]+$"},"status":{"type":"string","minLength":1},"client_reference_id":{"type":"string","minLength":1},"payment_status":{"type":"string","minLength":1},"amount_total":{"type":"integer","minimum":0},"currency":{"type":"string","pattern":"^[a-z]{3}$"},"livemode":{"type":"boolean"},"payment_intent":{}}},"result":{"id":"$.id","status":"$.status","attemptId":"$.client_reference_id","paymentStatus":"$.payment_status","amountMinor":"$.amount_total","currency":"$.currency","live":"$.livemode","paymentIntent":"$.payment_intent"},"resultOnly":true},
    "refundCheckout": {"idempotent":true,"input":{"type":"object","required":["paymentIntent"],"properties":{"paymentIntent":{"type":"string","pattern":"^pi_[A-Za-z0-9_]+$"},"amountMinor":{"type":"integer","minimum":1,"maximum":99999999}}},"request":{"method":"POST","url":"{base}/v1/refunds","headers":{"authorization":"Bearer {secret.apiKey}","stripe-version":"2024-06-20"},"encoding":"form","body":{"payment_intent":{"$":"input.paymentIntent"},"amount":{"$":"input.amountMinor"}}},"output":{"type":"object","required":["id","status","amount","currency","payment_intent"],"properties":{"id":{"type":"string","minLength":1},"status":{"type":"string","minLength":1},"amount":{"type":"integer","minimum":0},"currency":{"type":"string","pattern":"^[a-z]{3}$"},"payment_intent":{"type":"string","pattern":"^pi_[A-Za-z0-9_]+$"}}},"result":{"id":"$.id","status":"$.status","amountMinor":"$.amount","currency":"$.currency","paymentIntent":"$.payment_intent"},"resultOnly":true},
    "createPaymentIntent": {
      "summary": "create a PaymentIntent (amount in the currency's smallest unit, currency in lower case); with confirm and a paymentMethod it is charged at once",
      "idempotent": true,
      "input": {
        "type": "object",
        "required": ["amount", "currency"],
        "properties": {
          "amount": { "type": "integer", "minimum": 1, "maximum": 99999999 },
          "currency": { "type": "string", "pattern": "^[a-z]{3}$", "message": "a currency is three lower case letters, like usd" },
          "description": { "type": "string", "maxLength": 1000 },
          "paymentMethod": { "type": "string", "pattern": "^pm_[A-Za-z0-9_]+$", "message": "a payment method is a Stripe id, pm_..." },
          "confirm": { "type": "boolean" },
          "metadata": { "type": "object" }
        }
      },
      "request": {
        "method": "POST",
        "url": "{base}/v1/payment_intents",
        "encoding": "form",
        "headers": { "authorization": "Bearer {secret.apiKey}", "stripe-version": "2024-06-20" },
        "body": {
          "amount": { "$": "input.amount" },
          "currency": { "$": "input.currency" },
          "description": { "$": "input.description" },
          "payment_method": { "$": "input.paymentMethod" },
          "confirm": { "$": "input.confirm" },
          "metadata": { "$": "input.metadata" },
          "automatic_payment_methods": { "enabled": true, "allow_redirects": "never" }
        }
      },
      "output": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string" },
          "object": { "type": "string" },
          "status": { "type": "string" },
          "amount": { "type": "integer" },
          "currency": { "type": "string" },
          "client_secret": { "type": "string" },
          "livemode": { "type": "boolean" },
          "metadata": { "type": "object" }
        }
      },
      "result": { "id": "$.id", "status": "$.status" }
    },
    "retrievePaymentIntent": {
      "summary": "read a PaymentIntent by its id",
      "idempotent": true,
      "input": {
        "type": "object",
        "required": ["id"],
        "properties": { "id": { "type": "string", "pattern": "^pi_[A-Za-z0-9_]+$", "message": "a PaymentIntent is a Stripe id, pi_..." } }
      },
      "request": {
        "method": "GET",
        "url": "{base}/v1/payment_intents/{input.id}",
        "headers": { "authorization": "Bearer {secret.apiKey}", "stripe-version": "2024-06-20" }
      },
      "output": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string" },
          "object": { "type": "string" },
          "status": { "type": "string" },
          "amount": { "type": "integer" },
          "currency": { "type": "string" },
          "livemode": { "type": "boolean" },
          "metadata": { "type": "object" }
        }
      },
      "result": { "id": "$.id", "status": "$.status" }
    },
    "confirmPaymentIntent": {
      "summary": "confirm a PaymentIntent, optionally with the payment method to charge",
      "idempotent": true,
      "input": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^pi_[A-Za-z0-9_]+$", "message": "a PaymentIntent is a Stripe id, pi_..." },
          "paymentMethod": { "type": "string", "pattern": "^pm_[A-Za-z0-9_]+$", "message": "a payment method is a Stripe id, pm_..." }
        }
      },
      "request": {
        "method": "POST",
        "url": "{base}/v1/payment_intents/{input.id}/confirm",
        "encoding": "form",
        "headers": { "authorization": "Bearer {secret.apiKey}", "stripe-version": "2024-06-20" },
        "body": { "payment_method": { "$": "input.paymentMethod" } }
      },
      "output": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string" },
          "object": { "type": "string" },
          "status": { "type": "string" },
          "amount": { "type": "integer" },
          "currency": { "type": "string" },
          "livemode": { "type": "boolean" },
          "metadata": { "type": "object" }
        }
      },
      "result": { "id": "$.id", "status": "$.status" }
    },
    "createRefund": {
      "summary": "refund a PaymentIntent, all of it or an amount",
      "idempotent": true,
      "input": {
        "type": "object",
        "required": ["paymentIntent"],
        "properties": {
          "paymentIntent": { "type": "string", "pattern": "^pi_[A-Za-z0-9_]+$", "message": "a PaymentIntent is a Stripe id, pi_..." },
          "amount": { "type": "integer", "minimum": 1, "maximum": 99999999 },
          "reason": { "type": "string", "enum": ["duplicate", "fraudulent", "requested_by_customer"] },
          "metadata": { "type": "object" }
        }
      },
      "request": {
        "method": "POST",
        "url": "{base}/v1/refunds",
        "encoding": "form",
        "headers": { "authorization": "Bearer {secret.apiKey}", "stripe-version": "2024-06-20" },
        "body": {
          "payment_intent": { "$": "input.paymentIntent" },
          "amount": { "$": "input.amount" },
          "reason": { "$": "input.reason" },
          "metadata": { "$": "input.metadata" }
        }
      },
      "output": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string" },
          "object": { "type": "string" },
          "status": { "type": "string" },
          "amount": { "type": "integer" },
          "currency": { "type": "string" },
          "payment_intent": { "type": "string" }
        }
      },
      "result": { "id": "$.id", "status": "$.status" }
    }
  },
  "inbound": {
    "signature": { "scheme": "stripe" },
    "secret": "webhookSecret",
    "toleranceS": 300,
    "eventId": "$.id",
    "type": "$.type",
    "events": {
      "checkout.session.completed": {"schema":{"type":"object","required":["id","type","livemode","data"],"properties":{"id":{"type":"string","minLength":1},"type":{"type":"string","minLength":1},"livemode":{"type":"boolean"},"data":{"type":"object","required":["object"],"properties":{"object":{"type":"object","required":["id","client_reference_id","payment_status"],"properties":{"id":{"type":"string","pattern":"^cs_[A-Za-z0-9_]+$"},"client_reference_id":{},"payment_status":{"type":"string","minLength":1}}}}}}},"require":["attemptId"],"map":{"id":"$.data.object.id","attemptId":"$.data.object.client_reference_id","paymentStatus":"$.data.object.payment_status","live":"$.livemode"}},
      "checkout.session.async_payment_succeeded": {"schema":{"type":"object","required":["id","type","livemode","data"],"properties":{"id":{"type":"string","minLength":1},"type":{"type":"string","minLength":1},"livemode":{"type":"boolean"},"data":{"type":"object","required":["object"],"properties":{"object":{"type":"object","required":["id","client_reference_id","payment_status"],"properties":{"id":{"type":"string","pattern":"^cs_[A-Za-z0-9_]+$"},"client_reference_id":{},"payment_status":{"type":"string","minLength":1}}}}}}},"require":["attemptId"],"map":{"id":"$.data.object.id","attemptId":"$.data.object.client_reference_id","paymentStatus":"$.data.object.payment_status","live":"$.livemode"}},
      "checkout.session.async_payment_failed": {"schema":{"type":"object","required":["id","type","livemode","data"],"properties":{"id":{"type":"string","minLength":1},"type":{"type":"string","minLength":1},"livemode":{"type":"boolean"},"data":{"type":"object","required":["object"],"properties":{"object":{"type":"object","required":["id","client_reference_id","payment_status"],"properties":{"id":{"type":"string","pattern":"^cs_[A-Za-z0-9_]+$"},"client_reference_id":{},"payment_status":{"type":"string","minLength":1}}}}}}},"require":["attemptId"],"map":{"id":"$.data.object.id","attemptId":"$.data.object.client_reference_id","paymentStatus":"$.data.object.payment_status","live":"$.livemode"}},
      "checkout.session.expired": {"schema":{"type":"object","required":["id","type","livemode","data"],"properties":{"id":{"type":"string","minLength":1},"type":{"type":"string","minLength":1},"livemode":{"type":"boolean"},"data":{"type":"object","required":["object"],"properties":{"object":{"type":"object","required":["id","client_reference_id","payment_status"],"properties":{"id":{"type":"string","pattern":"^cs_[A-Za-z0-9_]+$"},"client_reference_id":{},"payment_status":{"type":"string","minLength":1}}}}}}},"require":["attemptId"],"map":{"id":"$.data.object.id","attemptId":"$.data.object.client_reference_id","paymentStatus":"$.data.object.payment_status","live":"$.livemode"}},
      "payment_intent.succeeded": {
        "schema": {
          "type": "object",
          "required": ["id", "type", "data"],
          "properties": {
            "id": { "type": "string" },
            "type": { "type": "string" },
            "data": { "type": "object", "required": ["object"], "properties": { "object": { "type": "object", "required": ["id", "amount"], "properties": { "id": { "type": "string" }, "amount": { "type": "integer" } } } } }
          }
        },
        "require": ["order"],
        "map": { "intent": "$.data.object.id", "amount": "$.data.object.amount", "currency": "$.data.object.currency", "order": "$.data.object.metadata.order" }
      },
      "payment_intent.payment_failed": {
        "schema": {
          "type": "object",
          "required": ["id", "type", "data"],
          "properties": {
            "id": { "type": "string" },
            "type": { "type": "string" },
            "data": { "type": "object", "required": ["object"], "properties": { "object": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" } } } } }
          }
        },
        "require": ["order"],
        "map": { "intent": "$.data.object.id", "order": "$.data.object.metadata.order", "reason": "$.data.object.last_payment_error.code" }
      },
      "charge.refunded": {
        "schema": {
          "type": "object",
          "required": ["id", "type", "data"],
          "properties": {
            "id": { "type": "string" },
            "type": { "type": "string" },
            "data": { "type": "object", "required": ["object"], "properties": { "object": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" } } } } }
          }
        },
        "require": ["order"],
        "map": { "charge": "$.data.object.id", "intent": "$.data.object.payment_intent", "refunded": "$.data.object.amount_refunded", "order": "$.data.object.metadata.order" }
      }
    }
  },
  "sandbox": {
    "test": { "op": "createPaymentIntent", "input": { "amount": 100, "currency": "usd", "description": "settings screen test" } },
    "operations": {
      "createCheckout": [{"body":{"id":"cs_sandbox_{key}","url":"https://checkout.stripe.com/sandbox/{key}"}}],
      "getCheckout": [{"body":{"id":{"$":"input.id"},"status":"open","client_reference_id":"sandbox-order","payment_status":"unpaid","amount_total":100,"currency":"usd","livemode":false,"payment_intent":null}}],
      "refundCheckout": [{"body":{"id":"re_sandbox_{key}","status":"succeeded","amount":{"$":"input.amountMinor"},"currency":"usd","payment_intent":{"$":"input.paymentIntent"}},"when":{"input.amountMinor":{"present":true}}},{"body":{"id":"re_sandbox_{key}","status":"succeeded","amount":100,"currency":"usd","payment_intent":{"$":"input.paymentIntent"}}}],
      "createPaymentIntent": [
        { "when": { "input.paymentMethod": "pm_card_chargeDeclined" }, "status": 402, "body": { "error": { "type": "card_error", "code": "card_declined", "decline_code": "generic_decline", "message": "Your card was declined." } } },
        { "when": { "input.confirm": true }, "body": { "id": "pi_sbx_{key}", "object": "payment_intent", "status": "succeeded", "amount": { "$": "input.amount" }, "currency": { "$": "input.currency" }, "client_secret": "pi_sbx_{key}_secret_sandbox", "livemode": false, "metadata": { "$": "input.metadata" } } },
        { "when": { "input.paymentMethod": { "present": true } }, "body": { "id": "pi_sbx_{key}", "object": "payment_intent", "status": "requires_confirmation", "amount": { "$": "input.amount" }, "currency": { "$": "input.currency" }, "client_secret": "pi_sbx_{key}_secret_sandbox", "livemode": false, "metadata": { "$": "input.metadata" } } },
        { "body": { "id": "pi_sbx_{key}", "object": "payment_intent", "status": "requires_payment_method", "amount": { "$": "input.amount" }, "currency": { "$": "input.currency" }, "client_secret": "pi_sbx_{key}_secret_sandbox", "livemode": false, "metadata": { "$": "input.metadata" } } }
      ],
      "retrievePaymentIntent": [
        { "body": { "id": { "$": "input.id" }, "object": "payment_intent", "status": "succeeded", "livemode": false } }
      ],
      "confirmPaymentIntent": [
        { "when": { "input.paymentMethod": "pm_card_chargeDeclined" }, "status": 402, "body": { "error": { "type": "card_error", "code": "card_declined", "decline_code": "generic_decline", "message": "Your card was declined." } } },
        { "body": { "id": { "$": "input.id" }, "object": "payment_intent", "status": "succeeded", "livemode": false } }
      ],
      "createRefund": [
        { "body": { "id": "re_sbx_{key}", "object": "refund", "status": "succeeded", "amount": { "$": "input.amount" }, "payment_intent": { "$": "input.paymentIntent" } } }
      ]
    }
  }
}
