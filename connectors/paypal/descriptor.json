{
  "descriptor": 1,
  "name": "paypal",
  "title": "PayPal Checkout",
  "base": "https://api-m.paypal.com",
  "modes": [
    "sandbox",
    "live"
  ],
  "idempotency": {
    "header": "PayPal-Request-Id"
  },
  "token": {
    "url": "https://api-m.paypal.com/v1/oauth2/token",
    "scheme": "basic",
    "clientId": "clientId",
    "clientSecret": "clientSecret"
  },
  "operations": {
    "createCheckout": {
      "idempotent": false,
      "input": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "amount": {
            "type": "string",
            "minLength": 1,
            "maxLength": 15,
            "pattern": "^(?:[1-9][0-9]{0,8}(?:\\.[0-9]{1,3})?|0\\.(?=[0-9]{1,3}$)[0-9]*[1-9][0-9]*)$"
          },
          "currency": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3,
            "pattern": "^[A-Z]{3}$"
          },
          "returnUrl": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]+)?/[^\\s]*$"
          },
          "cancelUrl": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]+)?/[^\\s]*$"
          }
        },
        "required": [
          "orderId",
          "amount",
          "currency",
          "returnUrl",
          "cancelUrl"
        ]
      },
      "request": {
        "method": "POST",
        "url": "{base}/v2/checkout/orders",
        "headers": {
          "content-type": "application/json",
          "Prefer": "return=representation"
        },
        "body": {
          "intent": "CAPTURE",
          "purchase_units": [
            {
              "reference_id": {
                "$": "input.orderId"
              },
              "custom_id": {
                "$": "input.orderId"
              },
              "amount": {
                "currency_code": {
                  "$": "input.currency"
                },
                "value": {
                  "$": "input.amount"
                }
              }
            }
          ],
          "payment_source": {
            "paypal": {
              "experience_context": {
                "shipping_preference": "NO_SHIPPING",
                "user_action": "PAY_NOW",
                "return_url": {
                  "$": "input.returnUrl"
                },
                "cancel_url": {
                  "$": "input.cancelUrl"
                }
              }
            }
          }
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[A-Z0-9]+$"
          },
          "status": {
            "type": "string",
            "enum": [
              "CREATED",
              "SAVED",
              "APPROVED",
              "VOIDED",
              "COMPLETED",
              "PAYER_ACTION_REQUIRED"
            ]
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rel": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                "href": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "^https://(?:api-m\\.(?:sandbox\\.)?paypal\\.com/|www\\.(?:sandbox\\.)?paypal\\.com/checkoutnow\\?)"
                }
              },
              "required": [
                "rel",
                "href"
              ]
            }
          }
        },
        "required": [
          "id",
          "status",
          "links"
        ]
      },
      "result": {
        "id": "$.id",
        "status": "$.status",
        "checkoutUrl": "$.links[rel=payer-action].href"
      },
      "resultOnly": true,
      "noReplay": true
    },
