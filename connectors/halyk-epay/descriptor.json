{
  "descriptor": 1,
  "name": "halyk-epay",
  "title": "Halyk ePay invoice links",
  "base": "https://epay-api.homebank.kz",
  "modes": [
    "sandbox",
    "live"
  ],
  "operations": {
    "createCheckout": {
      "idempotent": false,
      "input": {
        "type": "object",
        "required": [
          "invoiceId",
          "amount",
          "description",
          "returnUrl",
          "callbackUrl",
          "accountId",
          "recipientEmail",
          "recipientPhone"
        ],
        "properties": {
          "invoiceId": {
            "type": "string",
            "pattern": "^[0-9]{6,15}$"
          },
          "amount": {
            "type": "number",
            "minimum": 10,
            "maximum": 1000000000000
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 125
          },
          "returnUrl": {
            "type": "string",
            "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]+)?/[^\\s]*$"
          },
          "callbackUrl": {
            "type": "string",
            "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]+)?/[^\\s]*$"
          },
          "accountId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "recipientEmail": {
            "type": "string",
            "format": "email"
          },
          "recipientPhone": {
            "type": "string",
            "pattern": "^\\+7[0-9]{10}$"
          }
        }
      },
      "request": {
        "method": "POST",
        "url": "{base}/invoice",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "shop_id": {
            "$": "config.shopId"
          },
          "invoice_id": {
            "$": "input.invoiceId"
          },
          "amount": {
            "$": "input.amount"
          },
          "description": {
            "$": "input.description"
          },
          "currency": "KZT",
          "language": "rus",
          "expire_period": "1d",
          "back_link": {
            "$": "input.returnUrl"
          },
          "failure_back_link": {
            "$": "input.returnUrl"
          },
          "post_link": {
            "$": "input.callbackUrl"
          },
          "failure_post_link": {
            "$": "input.callbackUrl"
          },
          "account_id": {
            "$": "input.accountId"
          },
          "recipient_contact": {
            "$": "input.recipientEmail"
          },
          "recipient_contact_sms": {
            "$": "input.recipientPhone"
          }
        }
      },
      "output": {
        "type": "object",
        "required": [
          "id",
          "invoice_id",
          "status",
          "invoice_url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "invoice_id": {
            "type": "string",
            "pattern": "^[0-9]{6,15}$"
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "invoice_url": {
            "type": "string",
            "pattern": "^https://(?:epay|halykepay)\\.homebank\\.kz/"
          }
        }
      },
      "result": {
        "id": "$.id",
        "invoiceId": "$.invoice_id",
        "status": "$.status",
        "checkoutUrl": "$.invoice_url"
      },
      "resultOnly": true,
      "tokenScope": "payment"
    },
    "getCheckout": {
      "idempotent": true,
      "input": {
        "type": "object",
        "required": [
          "invoiceId"
        ],
        "properties": {
          "invoiceId": {
            "type": "string",
            "pattern": "^[0-9]{6,15}$"
          }
        }
      },
      "request": {
        "method": "GET",
        "url": "{base}/check-status/payment/transaction/{input.invoiceId}",
        "headers": {}
      },
      "output": {
        "type": "object",
        "required": [
          "resultCode",
          "transaction"
        ],
        "properties": {
          "resultCode": {
            "type": "string",
            "enum": [
              "100"
            ]
          },
          "transaction": {
            "type": "object",
            "required": [
              "id",
              "invoiceID",
              "amount",
              "currency",
              "statusName"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "invoiceID": {
                "type": "string",
                "pattern": "^[0-9]{6,15}$"
              },
              "amount": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000000000
              },
              "currency": {
                "type": "string",
                "enum": [
                  "KZT"
                ]
              },
              "statusName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        }
      },
      "result": {
        "id": "$.transaction.id",
        "invoiceId": "$.transaction.invoiceID",
        "amount": "$.transaction.amount",
        "currency": "$.transaction.currency",
        "status": "$.transaction.statusName"
      },
      "resultOnly": true,
      "tokenScope": "webapi usermanagement email_send verification statement statistics payment"
    },
    "refundCheckout": {
      "idempotent": false,
      "tokenScope": "webapi usermanagement email_send verification statement statistics payment",
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          }
        }
      },
      "request": {
        "method": "POST",
        "url": "{base}/operation/{input.id}/refund"
      }
    },
    "refundPartial": {
      "idempotent": false,
      "tokenScope": "webapi usermanagement email_send verification statement statistics payment",
      "input": {
        "type": "object",
        "required": [
          "id",
          "amount"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "amount": {
            "type": "number",
            "minimum": 10,
            "maximum": 1000000000000
          }
        }
      },
      "request": {
        "method": "POST",
        "url": "{base}/operation/{input.id}/refund?amount={input.amount}"
      }
    }
  },
  "sandbox": {
    "test": {
      "op": "getCheckout",
      "input": {
        "invoiceId": "123456"
      }
    },
    "operations": {
      "createCheckout": [
        {
          "body": {
            "id": "11111111-1111-4111-8111-111111111111",
            "invoice_id": {
              "$": "input.invoiceId"
            },
            "status": "ACTIVE",
            "invoice_url": "https://epay.homebank.kz/api/redirect/invoice-link/11111111-1111-4111-8111-111111111111"
          }
        }
      ],
      "getCheckout": [
        {
          "body": {
            "resultCode": "100",
            "transaction": {
              "id": "11111111-1111-4111-8111-111111111111",
              "invoiceID": {
                "$": "input.invoiceId"
              },
              "amount": 100,
              "currency": "KZT",
              "statusName": "CHARGE"
            }
          }
        }
      ],
      "refundCheckout": [
        {
          "body": {}
        }
      ],
      "refundPartial": [
        {
          "body": {}
        }
      ]
    }
  },
  "config": {
    "type": "object",
    "required": [
      "shopId"
    ],
    "properties": {
      "shopId": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
      }
    }
  },
  "token": {
    "url": "https://epay-oauth.homebank.kz/oauth2/token",
    "scheme": "form",
    "grantType": "client_credentials",
    "clientId": "clientId",
    "clientSecret": "clientSecret"
  }
}
