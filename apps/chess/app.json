{
  "app": "Chess",
  "task": "webgen-bench/000009",
  "note": "Full legal-move chess (check, castling, en passant, promotion, checkmate/stalemate) is a pure engine in apps/chess/engine.mjs (perft-verified: 20/400/8902 at depths 1-3 from the start position); plugins/chess.mjs is the registry glue (blocks + the 'chess' widget) that makes the server the sole authority, same shape as apps/tictactoe's ttt.move. AI opponent (stated per the brief): 'easy' plays a uniformly random legal move, 'hard' greedily takes the highest-value capture available (else random) — both one-ply, both seeded by (gameId, plyIndex) so outcomes are reproducible, no real search.",
  "theme": { "background": "aliceblue", "accent": "steelblue" },
  "home": "/page/home",
  "plugins": ["./plugins/chess.mjs"],

  "data": {
    "User": {
      "email": "text!", "password": "password!", "name": "text!",
      "role": "enum[admin,player]=player",
      "wins": "int=0", "losses": "int=0", "draws": "int=0"
    },
    "Game": {
      "white": "ref:User!", "black": "ref:User?",
      "mode": "enum[ai,human]=ai",
      "difficulty": "enum[easy,hard]=easy",
      "theme": "enum[classic,ocean,forest]=classic",
      "fen": "text=rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
      "status": "enum[waiting,playing,finished]=waiting",
      "result": "enum[none,white,black,draw]=none",
      "endReason": "enum[none,checkmate,stalemate,resignation]=none"
    },
    "Move": {
      "game": "ref:Game!", "ply": "int=1", "by": "ref:User?",
      "from": "text!", "to": "text!", "notation": "text!", "fenAfter": "text!"
    }
  },

  "rules": {
    "User": [ { "unique": "email" } ]
  },

  "roles": {
    "entity": "User", "login": "email", "password": "password", "role": "role",
    "register": "player", "anonymous": "guest",
    "can": {
      "admin": "*",
      "player": { "Game": { "own": ["white", "black"],
                            "can": ["view", "create", "go:join", "go:resign", "do:move", "do:undo", "do:setDifficulty", "do:setTheme"],
                            "all": ["view", "create", "go:join"] },
                  "Move": ["view"], "User": ["view"] },
      "guest":  { "Game": ["view"], "Move": ["view"], "User": ["view"] }
    }
  },

  "seed": {
    "User": [
      { "email": "admin@chess.test", "password": "admin123", "name": "Admin", "role": "admin" },
      { "email": "alice@chess.test", "password": "alice123", "name": "Alice", "wins": 3, "losses": 1, "draws": 0 },
      { "email": "bob@chess.test", "password": "bob12345", "name": "Bob", "wins": 1, "losses": 3, "draws": 1 },
      { "email": "ai@bot.test", "password": "not-a-real-login-1", "name": "Computer" }
    ],
    "Game": [
      { "white": 2, "black": 4, "mode": "ai", "difficulty": "easy", "status": "playing",
        "fen": "rnbqkbnr/ppp2ppp/4p3/3p4/3P4/5N2/PPP1PPPP/RNBQKB1R b KQkq - 1 3" },
      { "white": 2, "black": 3, "mode": "human", "status": "finished", "result": "black", "endReason": "checkmate",
        "fen": "rnb1kbnr/pppp1ppp/8/4p3/6Pq/5P2/PPPPP2P/RNBQKBNR w KQkq - 1 3" }
    ],
    "Move": [
      { "game": 1, "ply": 1, "by": 2, "from": "d2", "to": "d4", "notation": "d2-d4", "fenAfter": "rnbqkbnr/pppppppp/8/8/3P4/8/PPP1PPPP/RNBQKBNR b KQkq - 0 1" },
      { "game": 1, "ply": 2, "by": 4, "from": "e7", "to": "e6", "notation": "e7-e6", "fenAfter": "rnbqkbnr/pppp1ppp/4p3/8/3P4/8/PPP1PPPP/RNBQKBNR w KQkq - 0 2" },
      { "game": 1, "ply": 3, "by": 2, "from": "g1", "to": "f3", "notation": "Ng1-f3", "fenAfter": "rnbqkbnr/pppp1ppp/4p3/8/3P4/5N2/PPP1PPPP/RNBQKB1R b KQkq - 1 2" },
      { "game": 1, "ply": 4, "by": 4, "from": "d7", "to": "d5", "notation": "d7-d5", "fenAfter": "rnbqkbnr/ppp2ppp/4p3/3p4/3P4/5N2/PPP1PPPP/RNBQKB1R w KQkq d6 0 3" },
      { "game": 2, "ply": 1, "by": 2, "from": "f2", "to": "f3", "notation": "f2-f3", "fenAfter": "rnbqkbnr/pppppppp/8/8/8/5P2/PPPPP1PP/RNBQKBNR b KQkq - 0 1" },
      { "game": 2, "ply": 2, "by": 3, "from": "e7", "to": "e5", "notation": "e7-e5", "fenAfter": "rnbqkbnr/pppp1ppp/8/4p3/8/5P2/PPPPP1PP/RNBQKBNR w KQkq - 0 2" },
      { "game": 2, "ply": 3, "by": 2, "from": "g2", "to": "g4", "notation": "g2-g4", "fenAfter": "rnbqkbnr/pppp1ppp/8/4p3/6P1/5P2/PPPPP2P/RNBQKBNR b KQkq - 0 2" },
      { "game": 2, "ply": 4, "by": 3, "from": "d8", "to": "h4", "notation": "Qd8-h4#", "fenAfter": "rnb1kbnr/pppp1ppp/8/4p3/6Pq/5P2/PPPPP2P/RNBQKBNR w KQkq - 1 3" }
    ]
  },

  "views": "auto",
  "override": {
    "User.list": { "title": "Players", "columns": ["name", "wins", "losses", "draws"], "create": false, "rowActions": ["view"] },
    "User.detail": { "fields": ["name", "wins", "losses", "draws"] },
    "Game.list": { "title": "Games", "columns": ["id", "white", "black", "mode", "status", "result"],
                   "filters": [ { "name": "Status", "field": "status" }, { "name": "Mode", "field": "mode" } ],
                   "rowActions": ["view", "go:join"] },
    "Game.form": { "title": "New Game", "fields": ["mode", "difficulty", "theme"], "fill": { "white": "@me" },
                   "after": "/Game/{id}", "confirm": "New game started!" },
    "Game.detail": { "fields": ["white", "black", "mode", "difficulty", "theme", "status", "result", "endReason"],
                     "widget": { "use": "chess" }, "actions": ["undo"],
                     "related": [ { "entity": "Move", "via": "game", "title": "Move history",
                                    "columns": ["ply", "by", "from", "to", "notation"], "form": false, "rowActions": [] } ] },
    "Move.list": { "hidden": true, "filters": [ { "name": "Game", "field": "game" } ] }
  },

  "actions": [
    { "name": "move", "in": "Game", "after": "/Game/{id}",
      "do": [ { "block": "chess.move", "fromSq": "= values.from", "to": "= values.to", "promotion": "= values.promotion" } ] },
    { "name": "undo", "in": "Game", "after": "/Game/{id}", "confirm": "Move undone",
      "do": [ { "block": "chess.undo" } ] },
    { "name": "setDifficulty", "in": "Game", "after": "/Game/{id}", "confirm": "Difficulty set to {row.difficulty}",
      "do": [ { "block": "db.update", "set": { "difficulty": "= values.difficulty" } } ] },
    { "name": "setTheme", "in": "Game", "after": "/Game/{id}", "confirm": "Board theme set to {row.theme}",
      "do": [ { "block": "db.update", "set": { "theme": "= values.theme" } } ] }
  ],

  "events": [
    { "on": "Game.created", "do": [ { "block": "chess.setupGame" } ] }
  ],

  "states": {
    "Game": { "field": "status", "transitions": [
      { "name": "join", "from": ["waiting"], "to": "playing", "title": "Join Game", "by": ["player"],
        "confirm": "You joined as black", "do": [ { "block": "chess.join" } ] },
      { "name": "resign", "from": ["playing"], "to": "finished", "title": "Resign", "by": ["player"],
        "confirm": "You resigned. Game over.", "do": [ { "block": "chess.resign" } ] }
    ] }
  },

  "pages": [
    { "id": "home", "title": "Chess", "heading": "Online Chess", "roles": ["admin", "player", "guest"],
      "intro": "Play chess against the computer or another player: full rules including castling, en passant, promotion and checkmate/stalemate detection.",
      "links": [ { "label": "Games", "href": "/Game" }, { "label": "New Game", "href": "/Game/new" }, { "label": "Players", "href": "/User" } ] }
  ]
}
